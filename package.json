{
  "name": "immo-zen",
  "version": "0.1.0",
  "private": true,
  "description": "Immo-Zen – Prospectez, investissez et gérez vos locations sereinement.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "guides": "node scripts/guides.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:db": "bash supabase/tests/run-local.sh",
    "test:e2e": "node --import tsx tests/e2e/run.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
